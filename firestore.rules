rules_version = '2';
// قواعد حماية «حلقة البيت»: لا يقرأ بيانات العائلة إلا أفرادها، ولوحة القيادة (المدير) تقرأ الأرقام المجمّعة فقط.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'o.alhatlani@gmail.com' && request.auth.token.email_verified == true;
    }
    function fam(fid) { return /databases/$(database)/documents/families/$(fid); }
    function inFamily(fid) { return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/access/$(request.auth.uid)); }
    function isOwner(fid) { return signedIn() && get(fam(fid)).data.owner == request.auth.uid; }
    // هل هذا الجهاز صاحب الفرد؟ (uids = أجهزة الفرد)
    function ownsMember(fid, mid) {
      return request.auth.uid in get(/databases/$(database)/documents/families/$(fid)/members/$(mid)).data.get('uids', []);
    }
    function hasFamily() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }

    // دعوات إنشاء العائلات: ينشئها المدير، ويستعملها ولي الأمر مرة واحدة
    match /invites/{inv} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.used == false && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'fid', 'usedAt']);
    }

    match /families/{fid} {
      allow read: if inFamily(fid) || isAdmin();
      // الإنشاء: المدير مباشرة، وغيره بدعوة استُعملت في الدفعة نفسها باسمه ولهذه العائلة
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && (isAdmin() || (request.resource.data.invite is string
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.fid == fid));
      allow update: if isOwner(fid) && request.resource.data.owner == resource.data.owner;
      allow delete: if isAdmin();

      match /access/{uid} {
        allow read: if inFamily(fid) || isAdmin();
        allow create: if signedIn() && uid == request.auth.uid
          && ((request.resource.data.code is string && request.resource.data.code == get(fam(fid)).data.joinCode)
            || getAfter(fam(fid)).data.owner == request.auth.uid);
        allow delete: if isOwner(fid) || (signedIn() && uid == request.auth.uid);
      }
      // كل أفراد العائلة يرون الجميع، ولا يعدّل الفردَ إلا جهازه أو وليّ الأمر، ولا يحذفه إلا وليّ الأمر
      match /members/{mid} {
        allow read: if inFamily(fid);
        allow create: if inFamily(fid) && (isOwner(fid) || request.resource.data.uids == [request.auth.uid]);
        allow update: if inFamily(fid) && (
          isOwner(fid)
          || (request.auth.uid in resource.data.get('uids', []) && request.resource.data.uids == resource.data.uids)
          || (resource.data.get('uids', null) == [] && request.resource.data.uids == [request.auth.uid]));
        allow delete: if isOwner(fid);
        match /sessions/{sid} {
          allow read: if inFamily(fid);
          allow create, update: if inFamily(fid) && (isOwner(fid) || ownsMember(fid, mid));
          allow delete: if isOwner(fid);
        }
      }
    }

    // «سمّعني»: طلبات التسميع ونتائجها داخل العائلة. الحافظ (from) يطلب، والمسمِّع (to) يكتب النتيجة،
    // وجهاز الحافظ وحده يطبّقها على ملفّه (applied).
    match /families/{fid}/requests/{rid} {
      allow read: if inFamily(fid);
      allow create: if inFamily(fid) && request.resource.data.by == request.auth.uid
        && (isOwner(fid) || ownsMember(fid, request.resource.data.from)
          || (request.resource.data.to != null && ownsMember(fid, request.resource.data.to)));
      allow update: if inFamily(fid) && (isOwner(fid) || ownsMember(fid, resource.data.from)
        || (resource.data.to != null && ownsMember(fid, resource.data.to))
        || (resource.data.to == null && resource.data.status == 'pending'));
      allow delete: if inFamily(fid) && (resource.data.by == request.auth.uid || isOwner(fid));
    }

    match /joinCodes/{jc} {
      allow get: if signedIn();
      allow create: if signedIn() && getAfter(fam(request.resource.data.fid)).data.owner == request.auth.uid;
      allow delete: if signedIn() && get(fam(resource.data.fid)).data.owner == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // أرقام فقط للوحة القيادة
    match /pub/{mid} {
      allow read: if isAdmin();
      allow create: if inFamily(request.resource.data.fid)
        && (isOwner(request.resource.data.fid) || ownsMember(request.resource.data.fid, mid));
      allow update: if inFamily(resource.data.fid) && request.resource.data.fid == resource.data.fid
        && (isOwner(resource.data.fid) || ownsMember(resource.data.fid, mid));
      allow delete: if isAdmin() || isOwner(resource.data.fid);
    }
    match /daily/{day} {
      allow read: if isAdmin();
      allow create, update: if hasFamily();
    }
  }
}
